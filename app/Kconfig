mainmenu "kabot"

# Source the main Zephyr Kconfig tree
source "Kconfig.zephyr"

config KABOT_LOG_LEVEL_DEFAULT
    int "Default runtime log level"
    default 3
    range 0 4
    help
      Sets the default runtime log level applied at boot.
      0: OFF
      1: ERROR
      2: WARNING
      3: INFO
      4: DEBUG

config KABOT_MOTOR_SHELL
    bool "Enable motor shell commands"
    default y
    depends on SHELL
    help
      Enable the `motor` shell command group.

config KABOT_STATE_EGRESS_HOST
    string "State egress destination host"
    default "192.168.0.106"
    help
      IPv4 destination host for UDP state egress.

config KABOT_STATE_EGRESS_PORT
    int "State egress UDP port"
    default 30011
    range 1024 65535
    help
      UDP destination port for serialized State messages.

config KABOT_STATE_EGRESS_PERIOD_MS
    int "State egress publish period (ms)"
    default 100
    range 10 60000
    help
      Periodic state publish cadence in milliseconds for UDP egress.
      Lower values increase CPU and network load.

config KABOT_SENSOR_RETRY_PERIOD_MS
    int "Time between sensor initialization retries (ms)"
    default 1000
    range 100 2000
    help
      When sensor is not ready during first initialization trial
      Retry after speicifed period

config KABOT_STATE_TOP_FRAME_ID
    string "State top-level header frame_id"
    default "base_link"
    help
      Frame identifier used in top-level State.header for periodic egress snapshots.

config KABOT_STATE_EFFORT_FRAME_ID
    string "Effort state frame_id"
    default "motors"
    help
      Frame identifier for State.effort.header emitted from control updates.

config KABOT_STATE_IMU_FRAME_ID
    string "IMU frame_id"
    default "imu"
    help
      Frame identifier for linear_acceleration and angular_velocity simulated updates.

config KABOT_STATE_MAG_FRAME_ID
    string "Magnetometer frame_id"
    default "mag"
    help
      Frame identifier for magnetic_field simulated updates.

config KABOT_STATE_DISTANCE_FRAME_ID
    string "Distance frame_id"
    default "tof"
    help
  Frame identifier for distance updates.

config KABOT_STATE_LIGHT_LEFT_FRAME_ID
    string "Left light frame_id"
    default "light_left"
    help
      Frame identifier for left light updates.

config KABOT_STATE_LIGHT_RIGHT_FRAME_ID
    string "Right light frame_id"
    default "light_right"
    help
      Frame identifier for right light updates.

config KABOT_STATE_IMU_PERIOD_MS
    int "IMU simulated publish period (ms)"
    default 100
    range 10 60000
    help
      Refresh period for linear_acceleration and angular_velocity simulated state updates.

config KABOT_STATE_MAG_PERIOD_MS
    int "Magnetometer simulated publish period (ms)"
    default 200
    range 10 60000
    help
      Refresh period for magnetic_field simulated state updates.

config KABOT_STATE_DISTANCE_PERIOD_MS
    int "Distance publish period (ms)"
    default 17
    range 10 60000
    help
      Refresh period for distance state updates. 17 ms is approximately 60 Hz.

config KABOT_STATE_LIGHT_PERIOD_MS
    int "Light publish period (ms)"
  default 500
  range 500 2000
    help
      Refresh period for dual light state updates.

config KABOT_ENABLE_SIMULATED_STATE_SENSORS
    bool "Enable simulated state sensor publishers"
    default y if BOARD_NATIVE_SIM
    default n
    help
      Enable simulated IMU, magnetometer, and distance publishers.
      Disable this on real hardware to avoid mixing synthetic and physical sensor data.

config KABOT_ENABLE_SIMULATED_IMU_PUBLISHER
    bool "Enable simulated IMU publisher"
    depends on KABOT_ENABLE_SIMULATED_STATE_SENSORS
    default y
    help
      Enable simulated linear_acceleration and angular_velocity publishers.

config KABOT_ENABLE_SIMULATED_MAG_PUBLISHER
    bool "Enable simulated magnetometer publisher"
    depends on KABOT_ENABLE_SIMULATED_STATE_SENSORS
    default y
    help
      Enable simulated magnetic_field publisher.

config KABOT_ENABLE_SIMULATED_DISTANCE_PUBLISHER
    bool "Enable simulated distance publisher"
    depends on KABOT_ENABLE_SIMULATED_STATE_SENSORS
    default y
    help
      Enable simulated distance publisher.

config KABOT_ENABLE_DISTANCE_PUBLISHER
    bool "Enable real distance publisher"
    depends on SENSOR
    depends on DT_HAS_ST_VL53L0X_ENABLED
    default y
    help
      Enable VL53L0X-backed distance publisher that emits State.distance.

config KABOT_DISTANCE_PUBLISHER_STACK_SIZE
    int "Distance publisher stack size"
    default 2048
    range 1024 8192
    help
      Stack size in bytes for the distance publisher thread.

config KABOT_ENABLE_MAGNETOMETER_PUBLISHER
    bool "Enable real magnetometer publisher"
    depends on SENSOR
    depends on DT_HAS_MEMSIC_MMC56X3_ENABLED
    default y
    help
      Enable MMC56X3-backed magnetometer publisher that emits State.magnetic_field.

config KABOT_MAGNETOMETER_PUBLISHER_STACK_SIZE
    int "Magnetometer publisher stack size"
    default 2048
    range 1024 8192
    help
      Stack size in bytes for the magnetometer publisher thread.

config KABOT_ENABLE_IMU_PUBLISHER
    bool "Enable real IMU publisher"
    depends on SENSOR
    depends on DT_HAS_INVENSENSE_ICM42670P_ENABLED || DT_HAS_INVENSENSE_ICM42670S_ENABLED
    default y
    help
      Enable ICM42670-backed IMU publisher that emits State.linear_acceleration
      and State.angular_velocity.

config KABOT_IMU_PUBLISHER_STACK_SIZE
    int "IMU publisher stack size"
    default 2048
    range 1024 8192
    help
      Stack size in bytes for the IMU publisher thread.

config KABOT_ENABLE_LIGHT_PUBLISHER
    bool "Enable real light publisher"
    depends on SENSOR
    depends on DT_HAS_LITEON_LTR329_ENABLED
    default y
    help
      Enable dual LTR329-backed light publisher that emits State.light_left
      and State.light_right.

config KABOT_LIGHT_PUBLISHER_STACK_SIZE
    int "Light publisher stack size"
    default 2048
    range 1024 8192
    help
      Stack size in bytes for the light publisher thread.
