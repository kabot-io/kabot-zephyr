menuconfig MOTOR_DRIVER_MODULE
    bool "Enable motor driver module"
    default y
    help
      Enables the custom motor driver module.

if MOTOR_DRIVER_MODULE

config KABOT_ESC_MOTOR
    bool "ESC motor backend"
    default y if DT_HAS_KABOT_ESC_ENABLED
    help
      Enables support for kabot,esc motor devices.

config KABOT_H_BRIDGE_MOTOR
    bool "H-bridge motor backend"
    default y if DT_HAS_KABOT_H_BRIDGE_ENABLED
    help
      Enables support for kabot,h-bridge motor devices.

config KABOT_SIM_MOTOR
    bool "Simulated motor backend"
    default y if DT_HAS_KABOT_SIM_MOTOR_ENABLED
    help
      Enables support for kabot,sim-motor motor devices.

config KABOT_MOTOR_SHELL
    bool "Motor shell commands"
    default y
    depends on SHELL
    help
      Enables the 'motor' shell command for manual control and listing.

config MOTOR_DRIVER_INIT_PRIORITY
    int "Motor driver init priority"
    default 55
    range 0 999
    help
      Initialization priority for motor driver devices.
      Must be greater than CONFIG_PWM_INIT_PRIORITY so motor drivers are
      initialized after PWM.

endif # MOTOR_DRIVER_MODULE
