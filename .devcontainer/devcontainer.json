{
    "name": "Ubuntu",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "IMAGE_NAME": "${localEnv:IMAGE_NAME:dev-noble}",
            "IMAGE_TAG": "${localEnv:IMAGE_TAG:latest}"
        }
    },
    "privileged": true,
    "runArgs": [
        "--group-add",
        "dialout",
        "--group-add",
        "plugdev"
    ],
    "remoteEnv": {
        "ESPTOOL_PORT": "${localEnv:ESPTOOL_PORT:/dev/ttyACM0}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "maattdd.gitless",
                "josetr.cmake-language-support-vscode",
                "cheshirekow.cmake-format",
                "llvm-vs-code-extensions.vscode-clangd",
                "xaver.clang-format",
                "plorefice.devicetree",
                "EditorConfig.EditorConfig",
                "redhat.vscode-yaml",
                "HashiCorp.HCL",
                "GitHub.vscode-github-actions"
            ]
        }
    },
    "postCreateCommand": "scripts/post-create-script.zsh"
}
