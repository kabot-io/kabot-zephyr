{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build esp32s3",
            "type": "shell",
            "command": "./scripts/build.zsh --no-flash",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build and flash esp32s3",
            "type": "shell",
            "command": "./scripts/build.zsh --no-monitor",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build flash and monitor esp32s3",
            "type": "shell",
            "command": "./scripts/build.zsh",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Clean build directory",
            "type": "shell",
            "command": "rm -rf build",
            "problemMatcher": []
        }
    ]
}
